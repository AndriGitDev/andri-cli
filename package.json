{
  "name": "portfolio-cli-web",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "deploy": "vercel --prod",
    "setup-kv": "tsx scripts/setup-db.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "next": "^16.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^10",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "minimatch@3": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.9"
    },
    "postcss": "$postcss",
    "@babel/core": "^7.29.7",
    "@eslint/config-array": {
      "minimatch@10": "11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch@10": "11.0.8"
    },
    "eslint": {
      "minimatch@10": "11.0.8"
    }
  }
